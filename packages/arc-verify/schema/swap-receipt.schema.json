{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ryntra swap receipt",
  "description": "A receipt issued by Ryntra for one swap on Arc through an aggregator's router: what left the wallet and what reached it, each read from the swap's own Transfers, the quote at signing beside them — what was expected, the floor the router enforced, the price impact and the pools — and Ryntra's fee as its own line, paid by the router in the same transaction, with what the quote said and what the Transfer to Ryntra actually carried. Version 1.9.0; its `receiptHash` is SHA-256 over the canonical core in the domain `ryntra:swap-route-receipt:1.9.0`, so it cannot be read as Circle's exchange on the testnet (1.3.0, 1.5.0) or any other receipt. `execution` names the swap's transaction on Arc and `swap.provider.router` the contract it called. The seals and the rules across members cannot be written in JSON Schema; @ryntra/arc-verify recomputes the seals and reads the transaction on Arc.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.9.0"
    },
    "id": {
      "type": "string",
      "pattern": "^rcpt_[0-9a-f]{32}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "swap": {
      "type": "object",
      "properties": {
        "swapId": {
          "type": "string",
          "pattern": "^swp_[0-9a-f]{32}$"
        },
        "provider": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "KYBERSWAP",
                "RELAY"
              ]
            },
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "router": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "exchanges": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          },
          "required": [
            "name",
            "reference",
            "router",
            "exchanges"
          ],
          "additionalProperties": false
        },
        "chainRef": {
          "type": "string",
          "pattern": "^eip155:[1-9]\\d{0,9}$"
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        "sender": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "recipient": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "tokenIn": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            }
          },
          "required": [
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "tokenOut": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            }
          },
          "required": [
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "paid": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "received": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "quote": {
          "type": "object",
          "properties": {
            "quotedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "amountIn": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "expectedOut": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "minimumOut": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "priceImpactBps": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "slippageBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "source": {
              "type": "string",
              "enum": [
                "KYBERSWAP_ROUTE_BUILD",
                "RELAY_QUOTE_V2"
              ]
            }
          },
          "required": [
            "quotedAt",
            "amountIn",
            "expectedOut",
            "minimumOut",
            "priceImpactBps",
            "slippageBps",
            "source"
          ],
          "additionalProperties": false
        },
        "ryntraFee": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "bps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "IN",
                    "OUT"
                  ]
                },
                "mechanism": {
                  "type": "string",
                  "enum": [
                    "KYBERSWAP_ROUTER_FEE",
                    "RELAY_APP_FEE"
                  ]
                },
                "landing": {
                  "type": "string",
                  "enum": [
                    "SAME_TRANSACTION",
                    "PROVIDER_BALANCE"
                  ]
                },
                "quoted": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "asset": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "usd": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "amount",
                    "asset",
                    "usd"
                  ],
                  "additionalProperties": false
                },
                "actual": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "amount": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "asset": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 24
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "usd": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "amount",
                        "asset",
                        "usd"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "COLLECTED",
                    "ACCRUED_AT_PROVIDER",
                    "NOT_COLLECTED",
                    "UNREAD"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "bps",
                "side",
                "mechanism",
                "landing",
                "quoted",
                "actual",
                "state",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "providerFee": {
          "type": "object",
          "properties": {
            "amount": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "asset": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                {
                  "type": "null"
                }
              ]
            },
            "usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "amount",
            "asset",
            "usd"
          ],
          "additionalProperties": false
        },
        "networkFee": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)$"
                },
                "asset": {
                  "type": "string",
                  "const": "USDC"
                },
                "decimals": {
                  "type": "number",
                  "const": 18
                }
              },
              "required": [
                "amount",
                "asset",
                "decimals"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "deviations": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "swapId",
        "provider",
        "chainRef",
        "blockNumber",
        "sender",
        "recipient",
        "tokenIn",
        "tokenOut",
        "paid",
        "received",
        "quote",
        "ryntraFee",
        "networkFee",
        "deviations"
      ],
      "additionalProperties": false
    },
    "reconciliationStatus": {
      "type": "string",
      "enum": [
        "MATCHED",
        "DEVIATION_RECORDED"
      ]
    },
    "expectedEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "amountOut": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "feeAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
    },
    "actualEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "amountOut": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "feeAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "transactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "explorerUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "transactionHash",
        "explorerUrl"
      ],
      "additionalProperties": false
    },
    "reconciliation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MATCHED",
            "DEVIATION_RECORDED"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "CHAIN_READS"
            },
            "sourceRef": {
              "type": "string",
              "pattern": "^eip155:[1-9]\\d{0,9}:tx:0x[0-9a-f]{64}$"
            },
            "verificationStatus": {
              "type": "string",
              "const": "ONCHAIN_VERIFIED"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "provider",
            "sourceRef",
            "verificationStatus",
            "observedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finalizedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "swap",
    "reconciliationStatus",
    "expectedEffects",
    "actualEffects",
    "execution",
    "reconciliation",
    "limitations",
    "createdAt",
    "finalizedAt",
    "receiptHash",
    "integrity"
  ],
  "additionalProperties": false
}
