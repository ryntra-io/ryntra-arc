{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ryntra bridge transfer receipt",
  "description": "A receipt issued by Ryntra for one transfer into or out of Arc through Circle's CCTP: the burn on the source network, Circle's attested message, and the delivery on the destination, each read from its own chain and reconciled. Version 1.7.0; its `receiptHash` is SHA-256 over the canonical core in the domain `ryntra:bridge-transfer-receipt:1.7.0`, so it cannot be read as a transfer, a payout, an exchange, a received payment or the testnet's planned bridge (1.4.0). `execution` names the transaction on Arc — the mint for a transfer into Arc, the burn for one out of it — and `bridge` names both sides with their own chains and explorer pages. The seals and the rules across members cannot be written in JSON Schema; @ryntra/arc-verify recomputes the seals.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.7.0"
    },
    "id": {
      "type": "string",
      "pattern": "^rcpt_[0-9a-f]{32}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "bridge": {
      "type": "object",
      "properties": {
        "transferId": {
          "type": "string",
          "pattern": "^brg_[0-9a-f]{32}$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "INTO_ARC",
            "OUT_OF_ARC"
          ]
        },
        "asset": {
          "type": "string",
          "enum": [
            "USDC",
            "EURC"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "CCTP_V2",
            "CCTP_V2_NON_USDC"
          ]
        },
        "speed": {
          "type": "string",
          "enum": [
            "FAST",
            "STANDARD"
          ]
        },
        "finalityThreshold": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "arcSide": {
          "type": "string",
          "enum": [
            "SOURCE",
            "DESTINATION"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "chainRef": {
              "type": "string",
              "pattern": "^eip155:[1-9]\\d{0,9}$"
            },
            "domain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "transactionHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "explorerUrl": {
              "type": "string",
              "format": "uri"
            },
            "blockNumber": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)$"
            },
            "token": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "sender": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "networkFee": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)$"
            },
            "networkFeeAsset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            }
          },
          "required": [
            "label",
            "chainRef",
            "domain",
            "transactionHash",
            "explorerUrl",
            "blockNumber",
            "token",
            "amount",
            "sender",
            "networkFee",
            "networkFeeAsset"
          ],
          "additionalProperties": false
        },
        "attestation": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "CIRCLE_IRIS"
            },
            "status": {
              "type": "string",
              "const": "complete"
            },
            "nonce": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "finalityThresholdExecuted": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "feeExecuted": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "provider",
            "status",
            "nonce",
            "finalityThresholdExecuted",
            "feeExecuted",
            "observedAt"
          ],
          "additionalProperties": false
        },
        "destination": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "chainRef": {
              "type": "string",
              "pattern": "^eip155:[1-9]\\d{0,9}$"
            },
            "domain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "transactionHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "explorerUrl": {
              "type": "string",
              "format": "uri"
            },
            "blockNumber": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)$"
            },
            "token": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "recipient": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "feeCollected": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "deliveredBy": {
              "type": "string",
              "enum": [
                "CIRCLE_FORWARDING_SERVICE",
                "SENDER_WALLET",
                "ANOTHER_CALLER"
              ]
            }
          },
          "required": [
            "label",
            "chainRef",
            "domain",
            "transactionHash",
            "explorerUrl",
            "blockNumber",
            "token",
            "amount",
            "recipient",
            "feeCollected",
            "deliveredBy"
          ],
          "additionalProperties": false
        },
        "amounts": {
          "type": "object",
          "properties": {
            "sent": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "fee": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "received": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "maxFee": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "receiveAtLeast": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
            },
            "nativeFee": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)$"
            },
            "nativeFeeAsset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            }
          },
          "required": [
            "sent",
            "fee",
            "received",
            "maxFee",
            "receiveAtLeast",
            "nativeFee",
            "nativeFeeAsset"
          ],
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "properties": {
            "preparedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "burnFingerprint": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "burnCalldataHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "feeSource": {
              "type": "string",
              "enum": [
                "CIRCLE_IRIS_FEES",
                "CIRCLE_IRIS_QUOTE"
              ]
            },
            "feeObservedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "preparedAt",
            "expiresAt",
            "burnFingerprint",
            "burnCalldataHash",
            "feeSource",
            "feeObservedAt"
          ],
          "additionalProperties": false
        },
        "deviations": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "transferId",
        "direction",
        "asset",
        "protocol",
        "speed",
        "finalityThreshold",
        "arcSide",
        "source",
        "attestation",
        "destination",
        "amounts",
        "plan",
        "deviations"
      ],
      "additionalProperties": false
    },
    "reconciliationStatus": {
      "type": "string",
      "enum": [
        "MATCHED",
        "DEVIATION_RECORDED"
      ]
    },
    "expectedEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
        },
        "amountOut": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
        },
        "feeAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
    },
    "actualEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
        },
        "amountOut": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
        },
        "feeAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.\\d{6}$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "transactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "explorerUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "transactionHash",
        "explorerUrl"
      ],
      "additionalProperties": false
    },
    "reconciliation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MATCHED",
            "DEVIATION_RECORDED"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "CHAIN_READS_AND_CIRCLE_IRIS"
            },
            "sourceRef": {
              "type": "string",
              "minLength": 10,
              "maxLength": 160
            },
            "verificationStatus": {
              "type": "string",
              "const": "ONCHAIN_VERIFIED"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "provider",
            "sourceRef",
            "verificationStatus",
            "observedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finalizedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "bridge",
    "reconciliationStatus",
    "expectedEffects",
    "actualEffects",
    "execution",
    "reconciliation",
    "limitations",
    "createdAt",
    "finalizedAt",
    "receiptHash",
    "integrity"
  ],
  "additionalProperties": false
}
