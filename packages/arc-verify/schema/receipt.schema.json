            "chainId",
            "assetRef",
            "contractAddress",
            "decimals"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "rpcSourceRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "blockNumber": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "blockHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "transactionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "logIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "confirmations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
