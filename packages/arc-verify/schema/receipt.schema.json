        "amountBaseUnits",
        "beneficiaryRef",
        "beneficiaryVersion",
        "beneficiaryWalletAddress",
        "treasuryWalletAddress",
        "payoutInstructionHash",
        "beneficiaryVersionHash",
        "policyVersionHash",
        "approvalSetHash",
        "externalReferenceHash",
        "reservationId",
        "requiredApprovalCount",
        "receivedApprovalCount",
        "maxTotalDebitBaseUnits",
        "actualTotalDebitBaseUnits",
        "chain",
        "provenance"
      ],
      "additionalProperties": false
    },
    "swap": {
      "type": "object",
      "properties": {
        "quoteRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "routeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
