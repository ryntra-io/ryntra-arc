          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "policyVersionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "approvalSetHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "externalReferenceHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservationId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "requiredApprovalCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "receivedApprovalCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "requesterRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approverRefs": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "maxTotalDebitBaseUnits": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(0|[1-9]\\d*)$"
        },
        "actualTotalDebitBaseUnits": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(0|[1-9]\\d*)$"
        },
        "chain": {
          "type": "object",
          "properties": {
            "chainRef": {
              "type": "string",
              "pattern": "^[a-z0-9-]+:[A-Za-z0-9-]+$"
            },
