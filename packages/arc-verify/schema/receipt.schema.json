{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ryntra settlement receipt",
  "description": "A settlement receipt issued by Ryntra for one operation on Arc: what was approved, what the chain shows, and two SHA-256 seals over the canonical JSON of the record. The schema version selects the kind — 1.0.0 and 1.1.0 a transfer, 1.2.0 a payout (with `payout`), 1.3.0 and 1.5.0 an exchange (with `swap`), 1.4.0 a crosschain transfer (with `bridge`) — and the hash contract of `receiptHash`. Rules across members (the version-gated blocks, the approval timeline, the stated limitations, the seals themselves) cannot be written in JSON Schema; @ryntra/arc-verify recomputes the seals and reads the chain.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "tenantId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "evidenceStatus": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT",
        "CONFLICTING",
        "UNAVAILABLE"
      ]
    },
    "policyDecision": {
      "type": "string",
      "enum": [
        "ALLOWED_BY_POLICY",
        "REVIEW_REQUIRED",
        "BLOCKED_BY_RULE",
        "INSUFFICIENT_EVIDENCE",
        "UNSUPPORTED",
        "EXPIRED"
      ]
    },
    "authorizationStatus": {
      "type": "string",
      "const": "APPROVED"
    },
    "executionStatus": {
      "type": "string",
      "const": "CONFIRMED"
    },
    "policyVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "preflightHash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "expectedEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "amountOut": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "minimumAmountOut": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "feeAmount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "totalDebit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "minimumAmountOut",
        "feeAmount",
        "totalDebit"
      ],
      "additionalProperties": false
    },
    "actualEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "amountOut": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "feeAmount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
    },
    "reconciliationStatus": {
      "type": "string",
      "enum": [
        "MATCHED",
        "DEVIATION_RECORDED"
      ]
    },
    "intent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "hash"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "refs": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          }
        }
      },
      "required": [
        "root",
        "refs"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ALLOWED_BY_POLICY",
            "REVIEW_REQUIRED",
            "BLOCKED_BY_RULE",
            "INSUFFICIENT_EVIDENCE",
            "UNSUPPORTED",
            "EXPIRED"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "hash",
        "outcome"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "enum": [
            "PARTNER_AUTHENTICATED",
            "EIP712"
          ]
        },
        "subjectRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "executionFingerprintHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "id",
        "method",
        "subjectRef",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "fingerprintHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "bindingKind": {
          "type": "string",
          "enum": [
            "EVM_TRANSACTION",
            "APP_KIT_REQUEST"
          ]
        },
        "productionCalldataBound": {
          "type": "boolean"
        },
        "transactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "status": {
          "type": "string",
          "const": "CONFIRMED"
        },
        "explorerUrl": {
          "type": "string",
          "pattern": "^(?:https:\\/\\/testnet\\.arcscan\\.app|https:\\/\\/explorer\\.arc\\.io)\\/tx\\/0x[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "fingerprintHash",
        "bindingKind",
        "productionCalldataBound",
        "transactionHash",
        "status",
        "explorerUrl"
      ],
      "additionalProperties": false
    },
    "reconciliation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MATCHED",
            "DEVIATION_RECORDED"
          ]
        },
        "expected": {
          "type": "object",
          "properties": {
            "amountIn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "amountOut": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "minimumAmountOut": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "feeAmount": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "totalDebit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            }
          },
          "required": [
            "amountIn",
            "amountOut",
            "minimumAmountOut",
            "feeAmount",
            "totalDebit"
          ],
          "additionalProperties": false
        },
        "actual": {
          "type": "object",
          "properties": {
            "amountIn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "amountOut": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "feeAmount": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            }
          },
          "required": [
            "amountIn",
            "amountOut",
            "feeAmount"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "verificationStatus": {
              "type": "string",
              "enum": [
                "PROVIDER_REPORTED",
                "ONCHAIN_VERIFIED"
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "responseDigest": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          },
          "required": [
            "provider",
            "sourceRef",
            "verificationStatus",
            "observedAt",
            "responseDigest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "expected",
        "actual",
        "evidence"
      ],
      "additionalProperties": false
    },
    "settlement": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "CONFIRMED"
        },
        "recoveryState": {
          "type": "string",
          "const": "NOT_REQUIRED"
        }
      },
      "required": [
        "status",
        "recoveryState"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finalizedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "payout": {
      "type": "object",
      "properties": {
        "payoutId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
