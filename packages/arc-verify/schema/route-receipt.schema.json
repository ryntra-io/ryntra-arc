{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ryntra bridge route receipt",
  "description": "A receipt issued by Ryntra for one route across networks on any rail its bridge offers — Relay, Across, or Circle's bridge with the integrator's fee: what left on one network and what arrived on the other, each read from its own chain (or, for a network Ryntra does not read, as the provider reported it and said so), the quote at signing, and the integrator's fee as its own line with what was actually collected and the evidence for it. Version 1.8.0; its `receiptHash` is SHA-256 over the canonical core in the domain `ryntra:bridge-route-receipt:1.8.0`, so it cannot be read as a CCTP transfer receipt (1.7.0) or any other. `execution` names the transaction on Arc — the fill for a route into Arc, the deposit or burn for one out of it — and `route` names both sides with their own chains. The seals and the rules across members cannot be written in JSON Schema; @ryntra/arc-verify recomputes the seals.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.8.0"
    },
    "id": {
      "type": "string",
      "pattern": "^rcpt_[0-9a-f]{32}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "route": {
      "type": "object",
      "properties": {
        "transferId": {
          "type": "string",
          "pattern": "^(?:brg|rly|acr)_[0-9a-f]{32}$"
        },
        "rail": {
          "type": "string",
          "enum": [
            "RELAY",
            "ACROSS",
            "CIRCLE"
          ]
        },
        "provider": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "RELAY",
                "ACROSS",
                "CIRCLE_CCTP_V2"
              ]
            },
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "reference"
          ],
          "additionalProperties": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "WALLET",
            "DEPOSIT_ADDRESS"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "INTO_ARC",
            "OUT_OF_ARC"
          ]
        },
        "arcSide": {
          "type": "string",
          "enum": [
            "SOURCE",
            "DESTINATION"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "chainRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,7}:[A-Za-z0-9_-]{1,64}$"
            },
            "transactionHash": {
              "type": "string",
              "pattern": "^(?:0x[0-9a-f]{64}|[0-9a-f]{64}|[1-9A-HJ-NP-Za-km-z]{64,90})$"
            },
            "explorerUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "blockNumber": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "token": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 36
                }
              },
              "required": [
                "address",
                "symbol",
                "decimals"
              ],
              "additionalProperties": false
            },
            "amount": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "sender": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "networkFee": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "networkFeeAsset": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "label",
            "chainRef",
            "transactionHash",
            "explorerUrl",
            "blockNumber",
            "token",
            "amount",
            "sender",
            "networkFee",
            "networkFeeAsset"
          ],
          "additionalProperties": false
        },
        "destination": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "chainRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,7}:[A-Za-z0-9_-]{1,64}$"
            },
            "transactionHash": {
              "type": "string",
              "pattern": "^(?:0x[0-9a-f]{64}|[0-9a-f]{64}|[1-9A-HJ-NP-Za-km-z]{64,90})$"
            },
            "explorerUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "blockNumber": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "token": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 36
                }
              },
              "required": [
                "address",
                "symbol",
                "decimals"
              ],
              "additionalProperties": false
            },
            "amount": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "recipient": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "label",
            "chainRef",
            "transactionHash",
            "explorerUrl",
            "blockNumber",
            "token",
            "amount",
            "recipient"
          ],
          "additionalProperties": false
        },
        "quote": {
          "type": "object",
          "properties": {
            "quotedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "expectedOut": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "minimumOut": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
            },
            "seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 172800
            },
            "source": {
              "type": "string",
              "enum": [
                "RELAY_QUOTE_V2",
                "ACROSS_SWAP_APPROVAL",
                "CIRCLE_IRIS_FEES"
              ]
            }
          },
          "required": [
            "quotedAt",
            "expectedOut",
            "minimumOut",
            "seconds",
            "source"
          ],
          "additionalProperties": false
        },
        "ryntraFee": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "bps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "mechanism": {
                  "type": "string",
                  "enum": [
                    "RELAY_APP_FEE",
                    "ACROSS_APP_FEE",
                    "CIRCLE_CUSTOM_FEE"
                  ]
                },
                "landing": {
                  "type": "string",
                  "enum": [
                    "PROVIDER_BALANCE",
                    "DESTINATION_IN_TRANSACTION",
                    "SOURCE_IN_TRANSACTION"
                  ]
                },
                "quoted": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "asset": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "usd": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "amount",
                    "asset",
                    "usd"
                  ],
                  "additionalProperties": false
                },
                "actual": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "amount": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "asset": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 24
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "usd": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "amount",
                        "asset",
                        "usd"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "COLLECTED",
                    "ACCRUED_AT_PROVIDER",
                    "NOT_COLLECTED",
                    "UNREAD"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "bps",
                "mechanism",
                "landing",
                "quoted",
                "actual",
                "state",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "providerFee": {
          "type": "object",
          "properties": {
            "amount": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "asset": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                {
                  "type": "null"
                }
              ]
            },
            "usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "amount",
            "asset",
            "usd"
          ],
          "additionalProperties": false
        },
        "attestation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "CIRCLE_IRIS"
                },
                "nonce": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "finalityThresholdExecuted": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "feeExecuted": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "provider",
                "nonce",
                "finalityThresholdExecuted",
                "feeExecuted",
                "observedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "deviations": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "transferId",
        "rail",
        "provider",
        "mode",
        "direction",
        "arcSide",
        "source",
        "destination",
        "quote",
        "ryntraFee",
        "providerFee",
        "attestation",
        "deviations"
      ],
      "additionalProperties": false
    },
    "reconciliationStatus": {
      "type": "string",
      "enum": [
        "MATCHED",
        "DEVIATION_RECORDED"
      ]
    },
    "expectedEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "amountOut": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "feeAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
    },
    "actualEffects": {
      "type": "object",
      "properties": {
        "amountIn": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "amountOut": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        },
        "feeAmount": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,36})?$"
        }
      },
      "required": [
        "amountIn",
        "amountOut",
        "feeAmount"
      ],
      "additionalProperties": false
